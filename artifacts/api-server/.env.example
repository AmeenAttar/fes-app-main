DATABASE_URL=postgresql://localhost/fes_app
SESSION_SECRET=replace-with-strong-random-string
NODE_ENV=development
PORT=8080

# FES Center website base URL (no trailing slash). After the website
# migration, change this to https://fescenter.org and redeploy.
FESCENTER_BASE_URL=https://fescenter.org/test

# Cleveland FES Center geographic location. Used by /api/weather to fetch
# a current forecast for the Cleveland VA Medical Center / CWRU campus.
# Override only if the center physically relocates.
FES_LATITUDE=41.5045
FES_LONGITUDE=-81.6044
FES_LOCATION_LABEL=Cleveland, OH
