DATABASE_URL=postgresql://localhost/fes_app
SESSION_SECRET=replace-with-strong-random-string
NODE_ENV=development
PORT=8080

# Shared secret guarding the push-token write endpoints. Leave unset locally to
# skip enforcement; set it in production AND as EXPO_PUBLIC_API_TOKEN in the
# matching EAS build profile, or the app cannot register for notifications.
API_AUTH_TOKEN=

# Comma-separated browser origins allowed to call the API. Native apps send no
# Origin header and are unaffected. Unset means allow all.
ALLOWED_ORIGINS=

# FES Center website base URL (HTTPS; trailing slashes stripped). Scheme may be omitted
# (`fescenter.org` works). Mirror the same tier in Expo as EXPO_PUBLIC_FESCENTER_BASE_URL.
# The old /test tier is retired — production is https://fescenter.org.
FESCENTER_BASE_URL=https://fescenter.org

# Cleveland FES Center geographic location. Used by /api/weather to fetch
# a current forecast for the Cleveland VA Medical Center / CWRU campus.
# Override only if the center physically relocates.
FES_LATITUDE=41.5045
FES_LONGITUDE=-81.6044
FES_LOCATION_LABEL=Cleveland, OH

# RSVP: AddEvent / evt.to links are read from each Google Calendar event’s
# description (HTML links or pasted URLs). No separate API key is required.

# Google Sheets (Supporting Resources + Equipment tabs). Enable “Google Sheets API”
# in Google Cloud, create an API key, and keep it server-side only.
# The spreadsheet must be shared: “Anyone with the link” → Viewer.
GOOGLE_SHEETS_API_KEY=
# Optional overrides (defaults match the FES master workbook):
# GOOGLE_SHEETS_SPREADSHEET_ID=1EbT3Y1KQdMKUxrHhmezTnALdW3avdrkCrCft4mxt2kY
# INVENTORY_SHEET_NAME=Equipment
# SUPPORTING_RESOURCES_SHEET_NAME=Supporting Resources
