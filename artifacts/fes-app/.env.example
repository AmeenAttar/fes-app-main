EXPO_PUBLIC_DOMAIN=http://localhost:8080

# Must match API_AUTH_TOKEN on the api-server. Leave unset while the server
# isn't enforcing auth. Note this ships inside the binary — it blocks drive-by
# abuse of the push endpoints, not a determined attacker.
EXPO_PUBLIC_API_TOKEN=

# Same logical site tier as api-server FESCENTER_BASE_URL (hostname for UI labels only —
# investigator detail links still come from APIs). The /test tier is retired.
EXPO_PUBLIC_FESCENTER_BASE_URL=https://fescenter.org
